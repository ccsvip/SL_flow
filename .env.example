# Database
POSTGRES_USER=slflow
POSTGRES_PASSWORD=slflow
POSTGRES_DB=slflow
DB_PORT=5432

# Backend
BACKEND_PORT=8000
# REQUIRED: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# The backend refuses to start if this is left as the placeholder.
SECRET_KEY=replace-me-run-python-secrets-token_urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
ENABLE_HOT_RELOAD=true
# Comma-separated origins, or `*` for any (only used in dev mode hitting :8000 directly;
# in production the SPA shares the origin via Nginx so CORS is not in play)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Hot-update: HOST repo path (absolute, on the host filesystem) so the updater
# sibling container can mount the right source via the docker socket.
# Leave blank to auto-detect from `docker inspect $HOSTNAME`.
# Examples:
#   Linux/macOS: HOST_REPO_PATH=/srv/slflow
#   Windows:     HOST_REPO_PATH=C:\code\mine\SL_flow
HOST_REPO_PATH=
# Compose project name. Pin so the updater sibling targets the SAME stack.
COMPOSE_PROJECT_NAME=slflow

# Frontend
FRONTEND_PORT=8080
VITE_API_BASE=/api
